VOICE_PROVIDER=inhouse
PORT=8080

# In-house model settings.
# Leave INHOUSE_MODEL_PATH empty to use the bundled passthrough demo model.
# Point it at a CommonJS module exporting createModel() or process().
INHOUSE_MODEL_PATH=
INHOUSE_MODEL_GAIN=1.0

# Optional Resemble fallback provider.
RESEMBLE_API_KEY=
RESEMBLE_VOICE_UUID=

# Optional Voicemod fallback provider.
VOICEMOD_CLIENT_KEY=
VOICEMOD_VOICE_ID=
